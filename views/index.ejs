<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <form action="/search" method="get">
      <label for="search">Search Books</label>
      <input type="text" name="search_result" id="search" style="width: 15rem;" placeholder="name of book or name of author">
      <button type="submit">Search</button>
    </form>
    <br>
    <div>
      <a href="/new">Add new book</a>
    </div>
    <h1>Books</h1>
    <% if (locals.books){%>
      <% books.map(book => {%>
          <li>
            <img src="images/<%= book.book_url%>" alt="book cover">
            <p><%= book.book_name%></p>
            <a href="/detail/<%= book.id%>">details</a>
            <a href="/update/<%= book.id%>">update</a>
            <form action="/delete/book/<%= book.id%>" method="post" style="display: inline-block;">
              <button type="submit" onclick="return confirm('Are you sure to delete this book')">delete</button>
            </form>
            <p></p>
          </li>
      <%})%>
    <%}%>
    <h1>Authors</h1>
    <% if (locals.authors){%>
      <% authors.map(author => {%>
          <li>
            <img src="images/<%= author.author_url%>" alt="">
            <p><%= author.author_name%> </p>
            <form style="display: inline-block;" action="/delete/author/<%= author.id%>" method="post" >
              <button type="submit" onclick="return confirm('deleting can be fail if <%= author.author_name%> can have some books in library')">delete</button>
            </form>
          </li>
          <p></p>
      <%})%>
    <%}%>
  </body>
</html>
