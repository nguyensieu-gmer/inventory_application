<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <form action="/search" method="get">
      <label for="search">Search Books</label>
      <input type="text" name="search_result" id="search" style="width: 15rem;" placeholder="name of book or name of author">
      <button type="submit">Search</button>
    </form>
    <br>
    <div>
      <a href="/new">Add new book</a>
    </div>
    <h1>Books</h1>
    <% if (locals.books){%>
      <% books.map(book => {%>
          <li><%= book.book_name%> <a href="/detail/<%= book.id%>">details</a>
            <a href="/update/<%= book.id%>">update</a>
          </li>
      <%})%>
    <%}%>
    <h1>Authors</h1>
    <% if (locals.authors){%>
      <% authors.map(author => {%>
          <li><%= author.author_name%></li>
      <%})%>
    <%}%>
  </body>
</html>
