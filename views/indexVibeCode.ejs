<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard</title>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css"
    >

    <link rel="stylesheet" href="/styles.css">
</head>

<body>

<div class="container">

    <!-- ================= SIDEBAR ================= -->

    <div class="sidebar">

        <div class="side_bar_content">

            <div>
                <i class="ri-dashboard-fill"></i>
                <h1>Dashboard</h1>
            </div>

            <div>
                <i class="ri-home-fill"></i>
                <h1>Home</h1>
            </div>

            <div>
                <i class="ri-id-card-fill"></i>
                <h1>Profile</h1>
            </div>

            <div>
                <i class="ri-chat-4-fill"></i>
                <h1>Messages</h1>
            </div>

            <div>
                <i class="ri-chat-history-fill"></i>
                <h1>History</h1>
            </div>

            <div>
                <i class="ri-task-fill"></i>
                <h1>Tasks</h1>
            </div>

            <div>
                <i class="ri-discord-fill"></i>
                <h1>Community</h1>
            </div>

            <div>
                <i class="ri-settings-2-fill"></i>
                <h1>Settings</h1>
            </div>

            <div>
                <i class="ri-question-fill"></i>
                <h1>Support</h1>
            </div>

            <div>
                <i class="ri-shield-fill"></i>
                <h1>Privacy</h1>
            </div>

        </div>

    </div>


    <!-- ================= DASHBOARD ================= -->

    <div class="dashboard">

        <!-- NAVBAR -->

        <div class="nav_bar">

            <form action="/search" method="get" class="search">

                

                <input
                    type="search"
                    name="search_result"
                    id="search"
                    placeholder="name of book or name of author"
                >
                
                <button type="submit"><i class="ri-search-line"></i></button>

            </form>

            <i style="margin-left: auto;" class="ri-user-line"></i>

            <h2>Nguyen Sieu</h2>

        </div>


        <!-- CONTENT -->

        <div class="content_area">


            <!-- ================= BOOKS ================= -->

            <div class="novel">

                <div class="section_header">

                    <h1 class="title">Books</h1>

                    <a href="/new" class="add_button">
                        <i class="ri-add-line"></i>
                        Add new book
                    </a>

                </div>


                <% if (locals.books) { %>

                    <div class="novel_grid">

                        <% books.map(book => { %>

                            <div class="card">

                                <div class="image">

                                    <img
                                        src="/images/<%= book.book_url %>"
                                        alt="<%= book.book_name %>"
                                    >

                                </div>


                                <div class="infor">

                                    <h1>
                                        <%= book.book_name %>
                                    </h1>


                                    <div class="card_actions">

                                        <a href="/detail/<%= book.id %>">
                                            Details
                                        </a>

                                        <a href="/update/<%= book.id %>">
                                            Update
                                        </a>


                                        <form
                                            action="/delete/book/<%= book.id %>"
                                            method="post"
                                        >

                                            <button 
                                                type="submit"
                                                onclick="return confirm('Are you sure to delete this book')"
                                            >
                                                Delete
                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        <% }) %>

                    </div>

                <% } %>

            </div>



            <!-- ================= AUTHORS ================= -->

            <div class="author">

                <div class="section_header">

                    <h1 class="title">Authors</h1>

                </div>


                <% if (locals.authors) { %>

                    <div class="author_grid">

                        <% authors.map(author => { %>

                            <div>
                                <div class="author_img">

                                <img
                                    src="/images/<%= author.author_url %>"
                                    alt="<%= author.author_name %>"
                                >


                                <div class="overlay">

                                    <h3>
                                        <%= author.author_name %>
                                    </h3>


                                    

                                </div>

                            </div>
                            <div style="display: flex; justify-content: center; align-items: center;">
                                <form
                                        action="/delete/author/<%= author.id %>"
                                        method="post"
                                    >
                                        <button
                                            style="background-color: #fff1f2;color: #e11d48; margin-top: 1rem;"
                                            type="submit"
                                            onclick="return confirm('Deleting can fail if <%= author.author_name %> has some books in the library')"
                                        >
                                            Delete
                                </button>
                                </form>
                                
                            </div>
                            </div>

                        <% }) %>

                    </div>

                <% } %>

            </div>

        </div>

    </div>

</div>

</body>
</html>
```
